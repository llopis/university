uppercase = true

[node name="FeesHelp" parent="Body/Columns/Fees/FeesHeader" instance=ExtResource("4_help")]
layout_mode = 2
tooltip_text = "Fees arrive as a lump at the start of each semester, at today's enrolment."

[node name="TuitionRow" parent="Body/Columns/Fees" instance=ExtResource("3_row")]
