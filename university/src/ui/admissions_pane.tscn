[gd_scene load_steps=4 format=3]

[ext_resource type="Script" path="res://src/ui/admissions_pane.gd" id="1_pane"]
[ext_resource type="PackedScene" path="res://src/ui/stepper.tscn" id="2_stepper"]
[ext_resource type="PackedScene" path="res://src/ui/help_icon.tscn" id="3_help"]

[node name="AdmissionsPane" type="VBoxContainer"]
theme_override_constants/separation = 14
script = ExtResource("1_pane")

[node name="Intake" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 8

[node name="IntakeHeader" type="HBoxContainer" parent="Intake"]
layout_mode = 2

[node name="IntakeTitle" type="Label" parent="Intake/IntakeHeader"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"Heading"
uppercase = true

[node name="IntakeHelp" parent="Intake/IntakeHeader" instance=ExtResource("3_help")]
layout_mode = 2
tooltip_text = "At today's reputation and next year's prices. Seats fill from the top of the applicant list; how many apply depends on reputation and on the total price. Empty seats are upkeep with no tuition."

[node name="Stages" type="HBoxContainer" parent="Intake"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="SeatsStage" type="PanelContainer" parent="Intake/Stages"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"StageOn"

[node name="Layout" type="VBoxContainer" parent="Intake/Stages/SeatsStage"]
layout_mode = 2
theme_override_constants/separation = 2

[node name="SeatsValue" type="Label" parent="Intake/Stages/SeatsStage/Layout"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"Value"

[node name="Caption" type="Label" parent="Intake/Stages/SeatsStage/Layout"]
layout_mode = 2
theme_type_variation = &"Caption"
uppercase = true
text = "Seats to fill"

[node name="SeatsDetail" type="Label" parent="Intake/Stages/SeatsStage/Layout"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"Caption"
autowrap_mode = 3

[node name="ApplicantsStage" type="PanelContainer" parent="Intake/Stages"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"Stage"

[node name="Layout" type="VBoxContainer" parent="Intake/Stages/ApplicantsStage"]
layout_mode = 2
theme_override_constants/separation = 2

[node name="ApplicantsValue" type="Label" parent="Intake/Stages/ApplicantsStage/Layout"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"Value"

[node name="Caption" type="Label" parent="Intake/Stages/ApplicantsStage/Layout"]
layout_mode = 2
theme_type_variation = &"Caption"
uppercase = true
text = "Expected applicants"

[node name="ApplicantsDetail" type="Label" parent="Intake/Stages/ApplicantsStage/Layout"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"Caption"
autowrap_mode = 3

[node name="IntakeStage" type="PanelContainer" parent="Intake/Stages"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"Stage"

[node name="Layout" type="VBoxContainer" parent="Intake/Stages/IntakeStage"]
layout_mode = 2
theme_override_constants/separation = 2

[node name="IntakeValue" type="Label" parent="Intake/Stages/IntakeStage/Layout"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"Value"

[node name="Caption" type="Label" parent="Intake/Stages/IntakeStage/Layout"]
layout_mode = 2
theme_type_variation = &"Caption"
uppercase = true
text = "Expected intake"

[node name="IntakeDetail" type="Label" parent="Intake/Stages/IntakeStage/Layout"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"Caption"
autowrap_mode = 3

[node name="History" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 6

[node name="SectionTitle" type="Label" parent="History"]
layout_mode = 2
theme_type_variation = &"Heading"
uppercase = true
text = "Applicants per fall"

[node name="Chart" type="HBoxContainer" parent="History"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 5
custom_minimum_size = Vector2(0, 80)

[node name="NoFallsNote" type="Label" parent="History"]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_type_variation = &"BodyWarn"
text = "No fall admission yet."

[node name="Levers" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 8

[node name="LeversHeader" type="HBoxContainer" parent="Levers"]
layout_mode = 2

[node name="SectionTitle" type="Label" parent="Levers/LeversHeader"]
layout_mode = 2
theme_type_variation = &"Heading"
uppercase = true
text = "Levers"

[node name="Spacer" type="Control" parent="Levers/LeversHeader"]
layout_mode = 2
size_flags_horizontal = 3

[node name="ApplyNote" type="Label" parent="Levers/LeversHeader"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"Caption"

[node name="MinimumLever" type="PanelContainer" parent="Levers"]
layout_mode = 2
theme_type_variation = &"Lever"

[node name="Layout" type="VBoxContainer" parent="Levers/MinimumLever"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="LeverTitleRow" type="HBoxContainer" parent="Levers/MinimumLever/Layout"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="LeverTitle" type="Label" parent="Levers/MinimumLever/Layout/LeverTitleRow"]
layout_mode = 2
theme_type_variation = &"Heading"
uppercase = true
text = "Minimum entry grade"

[node name="MinimumHelp" parent="Levers/MinimumLever/Layout/LeverTitleRow" instance=ExtResource("3_help")]
layout_mode = 2
tooltip_text = "Off: every seat that has an applicant fills, and the entry grade follows how many apply. Raise it to leave seats empty in a weak year: tuition now against reputation later."

[node name="MinimumStepper" parent="Levers/MinimumLever/Layout" instance=ExtResource("2_stepper")]
unique_name_in_owner = true
layout_mode = 2

[node name="TuitionLever" type="PanelContainer" parent="Levers"]
layout_mode = 2
theme_type_variation = &"Lever"

[node name="Layout" type="VBoxContainer" parent="Levers/TuitionLever"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="LeverTitle" type="Label" parent="Levers/TuitionLever/Layout"]
layout_mode = 2
theme_type_variation = &"Heading"
uppercase = true
text = "Tuition per semester"

[node name="TuitionNow" type="Label" parent="Levers/TuitionLever/Layout"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"Caption"

[node name="TuitionStepper" parent="Levers/TuitionLever/Layout" instance=ExtResource("2_stepper")]
unique_name_in_owner = true
layout_mode = 2

[node name="HousingLever" type="PanelContainer" parent="Levers"]
layout_mode = 2
theme_type_variation = &"Lever"

[node name="Layout" type="VBoxContainer" parent="Levers/HousingLever"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="LeverTitleRow" type="HBoxContainer" parent="Levers/HousingLever/Layout"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="LeverTitle" type="Label" parent="Levers/HousingLever/Layout/LeverTitleRow"]
layout_mode = 2
theme_type_variation = &"Heading"
uppercase = true
text = "Room and meal plan per semester"

[node name="HousingHelp" parent="Levers/HousingLever/Layout/LeverTitleRow" instance=ExtResource("3_help")]
unique_name_in_owner = true
layout_mode = 2

[node name="HousingNow" type="Label" parent="Levers/HousingLever/Layout"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"Caption"

[node name="RoomStepper" parent="Levers/HousingLever/Layout" instance=ExtResource("2_stepper")]
unique_name_in_owner = true
layout_mode = 2

[node name="MealStepper" parent="Levers/HousingLever/Layout" instance=ExtResource("2_stepper")]
unique_name_in_owner = true
layout_mode = 2

[node name="Jumps" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 6

[node name="StudentsJump" type="Button" parent="Jumps"]
unique_name_in_owner = true
layout_mode = 2
focus_mode = 0
theme_type_variation = &"JumpButton"
text = "Students →"

[node name="FinancesJump" type="Button" parent="Jumps"]
unique_name_in_owner = true
layout_mode = 2
focus_mode = 0
theme_type_variation = &"JumpButton"
text = "Finances →"
