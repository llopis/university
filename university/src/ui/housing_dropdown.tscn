[gd_scene load_steps=5 format=3]

[ext_resource type="Script" path="res://src/ui/housing_dropdown.gd" id="1_housing"]
[ext_resource type="PackedScene" path="res://src/ui/kpi.tscn" id="2_kpi"]
[ext_resource type="PackedScene" path="res://src/ui/info_row.tscn" id="3_row"]
[ext_resource type="PackedScene" path="res://src/ui/dining_load_line.tscn" id="4_dining"]

[node name="HousingDropdown" type="PanelContainer"]
visible = false
custom_minimum_size = Vector2(640, 0)
anchors_preset = 0
offset_left = 420.0
offset_top = 72.0
theme_type_variation = &"Dropdown"
script = ExtResource("1_housing")

[node name="Body" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Title" type="Label" parent="Body"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"Heading"
uppercase = true

[node name="Kpis" type="HBoxContainer" parent="Body"]
layout_mode = 2
theme_override_constants/separation = 26

[node name="FilledKpi" parent="Body/Kpis" instance=ExtResource("2_kpi")]
unique_name_in_owner = true
layout_mode = 2

[node name="OffCampusKpi" parent="Body/Kpis" instance=ExtResource("2_kpi")]
unique_name_in_owner = true
layout_mode = 2

[node name="ThresholdKpi" parent="Body/Kpis" instance=ExtResource("2_kpi")]
unique_name_in_owner = true
layout_mode = 2

[node name="OpeningKpi" parent="Body/Kpis" instance=ExtResource("2_kpi")]
unique_name_in_owner = true
layout_mode = 2

[node name="OverflowNote" type="Label" parent="Body"]
layout_mode = 2
theme_type_variation = &"CaptionWarn"
autowrap_mode = 3
text = "Off-campus students pay tuition only: no room fee and no meal plan. Past the threshold, satisfaction drops for the whole university."

[node name="Dorms" type="GridContainer" parent="Body"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/h_separation = 16
theme_override_constants/v_separation = 6
columns = 3

[node name="Dorm" type="Label" parent="Body/Dorms"]
layout_mode = 2
theme_type_variation = &"Heading"
uppercase = true
text = "Dorm"

[node name="Beds" type="Label" parent="Body/Dorms"]
layout_mode = 2
theme_type_variation = &"Heading"
uppercase = true
text = "Beds"

[node name="Upkeep" type="Label" parent="Body/Dorms"]
layout_mode = 2
theme_type_variation = &"Heading"
uppercase = true
text = "Upkeep / mo"

[node name="Dining" type="VBoxContainer" parent="Body"]
layout_mode = 2

[node name="SectionTitle" type="Label" parent="Body/Dining"]
layout_mode = 2
theme_type_variation = &"Heading"
uppercase = true
text = "Dining"

[node name="DinersRow" parent="Body/Dining" instance=ExtResource("3_row")]
unique_name_in_owner = true
layout_mode = 2

[node name="LoadLine" type="HBoxContainer" parent="Body/Dining"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 10

[node name="Key" type="Label" parent="Body/Dining/LoadLine"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"Caption"
text = "Load"

[node name="DiningLoadLine" parent="Body/Dining/LoadLine" instance=ExtResource("4_dining")]
unique_name_in_owner = true
layout_mode = 2

[node name="NoDiningNote" type="Label" parent="Body/Dining"]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_type_variation = &"BodyWarn"
text = "No dining hall: housed students can't eat."

[node name="Foot" type="HBoxContainer" parent="Body"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="AdmissionsJump" type="Button" parent="Body/Foot"]
unique_name_in_owner = true
layout_mode = 2
focus_mode = 0
theme_type_variation = &"JumpButton"
text = "Room & meal plan prices →"
