layout_mode = 2
focus_mode = 0
theme_type_variation = &"GhostButton"

[node name="RepayButton" type="Button" parent="Body/Columns/CreditLine/LoanButtons"]
unique_name_in_owner = true
layout_mode = 2
focus_mode = 0
theme_type_variation = &"GhostButton"

[node name="Fees" type="VBoxContainer" parent="Body/Columns"]
layout_mode = 2
size_flags_horizontal = 3

[node name="FeesHeader" type="HBoxContainer" parent="Body/Columns/Fees"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="FeesTitle" type="Label" parent="Body/Columns/Fees/FeesHeader"]
unique_name_in_owner = true
layout_mode = 2
