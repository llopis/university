theme_type_variation = &"Heading"
uppercase = true
text = "Target: half grades, half satisfaction"

[node name="TargetHelp" parent="Body/Columns/Target/TitleRow" instance=ExtResource("4_help")]
unique_name_in_owner = true
layout_mode = 2

[node name="GradeRow" parent="Body/Columns/Target" instance=ExtResource("3_row")]
unique_name_in_owner = true
layout_mode = 2

[node name="YearSatisfactionRow" parent="Body/Columns/Target" instance=ExtResource("3_row")]
unique_name_in_owner = true
layout_mode = 2

[node name="TargetRow" parent="Body/Columns/Target" instance=ExtResource("3_row")]
