[gd_scene load_steps=6 format=3]

[ext_resource type="Script" path="res://src/ui/housing_dropdown.gd" id="1_housing"]
[ext_resource type="PackedScene" path="res://src/ui/kpi.tscn" id="2_kpi"]
[ext_resource type="PackedScene" path="res://src/ui/info_row.tscn" id="3_row"]
[ext_resource type="PackedScene" path="res://src/ui/dining_load_line.tscn" id="4_dining"]
[ext_resource type="PackedScene" path="res://src/ui/help_icon.tscn" id="5_help"]

[node name="HousingDropdown" type="PanelContainer"]
visible = false
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
offset_top = 72.0
theme_type_variation = &"Overlay"
script = ExtResource("1_housing")

[node name="Scroll" type="ScrollContainer" parent="."]
layout_mode = 2
horizontal_scroll_mode = 0

[node name="Center" type="CenterContainer" parent="Scroll"]
layout_mode = 2
size_flags_horizontal = 3

[node name="Content" type="VBoxContainer" parent="Scroll/Center"]
layout_mode = 2
custom_minimum_size = Vector2(1440, 0)
theme_override_constants/separation = 12

[node name="Header" type="HBoxContainer" parent="Scroll/Center/Content"]
layout_mode = 2

[node name="Title" type="Label" parent="Scroll/Center/Content/Header"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"Title"

[node name="Spacer" type="Control" parent="Scroll/Center/Content/Header"]
layout_mode = 2
size_flags_horizontal = 3

[node name="CloseButton" type="Button" parent="Scroll/Center/Content/Header"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 0
focus_mode = 0
theme_type_variation = &"CloseButton"
text = "×"

[node name="Kpis" type="HBoxContainer" parent="Scroll/Center/Content"]
layout_mode = 2
theme_override_constants/separation = 26

[node name="FilledKpi" parent="Scroll/Center/Content/Kpis" instance=ExtResource("2_kpi")]
unique_name_in_owner = true
layout_mode = 2

[node name="OffCampusKpi" parent="Scroll/Center/Content/Kpis" instance=ExtResource("2_kpi")]
unique_name_in_owner = true
layout_mode = 2

[node name="OffCampusHelp" parent="Scroll/Center/Content/Kpis" instance=ExtResource("5_help")]
layout_mode = 2
tooltip_text = "Off-campus students pay tuition only: no room fee and no meal plan. Past the threshold, satisfaction drops for the whole university."

[node name="ThresholdKpi" parent="Scroll/Center/Content/Kpis" instance=ExtResource("2_kpi")]
unique_name_in_owner = true
layout_mode = 2

[node name="OpeningKpi" parent="Scroll/Center/Content/Kpis" instance=ExtResource("2_kpi")]
unique_name_in_owner = true
layout_mode = 2

[node name="Columns" type="HBoxContainer" parent="Scroll/Center/Content"]
layout_mode = 2
theme_override_constants/separation = 48

[node name="Left" type="VBoxContainer" parent="Scroll/Center/Content/Columns"]
layout_mode = 2
size_flags_horizontal = 3

[node name="Dorms" type="GridContainer" parent="Scroll/Center/Content/Columns/Left"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/h_separation = 16
theme_override_constants/v_separation = 6
columns = 3

[node name="Dorm" type="Label" parent="Scroll/Center/Content/Columns/Left/Dorms"]
layout_mode = 2
theme_type_variation = &"Heading"
uppercase = true
text = "Dorm"

[node name="Beds" type="Label" parent="Scroll/Center/Content/Columns/Left/Dorms"]
layout_mode = 2
theme_type_variation = &"Heading"
uppercase = true
text = "Beds"

[node name="Upkeep" type="Label" parent="Scroll/Center/Content/Columns/Left/Dorms"]
layout_mode = 2
theme_type_variation = &"Heading"
uppercase = true
text = "Upkeep / mo"

[node name="Right" type="VBoxContainer" parent="Scroll/Center/Content/Columns"]
layout_mode = 2
size_flags_horizontal = 3

[node name="Dining" type="VBoxContainer" parent="Scroll/Center/Content/Columns/Right"]
layout_mode = 2

[node name="SectionTitle" type="Label" parent="Scroll/Center/Content/Columns/Right/Dining"]
layout_mode = 2
theme_type_variation = &"Heading"
uppercase = true
text = "Dining"

[node name="DinersRow" parent="Scroll/Center/Content/Columns/Right/Dining" instance=ExtResource("3_row")]
unique_name_in_owner = true
layout_mode = 2

[node name="LoadLine" type="HBoxContainer" parent="Scroll/Center/Content/Columns/Right/Dining"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 10

[node name="Key" type="Label" parent="Scroll/Center/Content/Columns/Right/Dining/LoadLine"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"Body"
text = "Load"

[node name="DiningLoadLine" parent="Scroll/Center/Content/Columns/Right/Dining/LoadLine" instance=ExtResource("4_dining")]
unique_name_in_owner = true
layout_mode = 2

[node name="NoDiningNote" type="Label" parent="Scroll/Center/Content/Columns/Right/Dining"]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_type_variation = &"BodyWarn"
text = "No dining hall: housed students can't eat."

[node name="Foot" type="HBoxContainer" parent="Scroll/Center/Content"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="AdmissionsJump" type="Button" parent="Scroll/Center/Content/Foot"]
unique_name_in_owner = true
layout_mode = 2
focus_mode = 0
theme_type_variation = &"JumpButton"
text = "Room & meal plan prices →"
